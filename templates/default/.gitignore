# Composer による依存パッケージのインストール先
vendor/

# PHPStan のキャッシュ
.phpstan-cache/

# PHPUnit のキャッシュ
.phpunit.cache/### Generated by gibo (https://github.com/simonwhitaker/gibo)

# Python のキャッシュ
__pycache__/

# Node.js の依存パッケージのインストール先
node_modules/

# VS Code の個人設定 (共有されるべきワークスペース設定は除外)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets
!*.code-workspace
*.vsix

# Claude 個人設定
.claude/settings.local.json

# Claude ローカル作業
.claude/works/
.claude/worktrees/

# ローカル環境設定 (AWS CLI プロファイル名など個人ごとに異なる値を含む)
.env
.env.*
!.env.example